<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>InCatalog — Third-party licenses</title>
    <style>
      body { font: 14px/1.5 system-ui, sans-serif; max-width: 60rem; margin: 2rem auto; padding: 0 1rem; }
      h2 { border-top: 1px solid #ccc; padding-top: 1rem; margin-top: 2rem; }
      .crates { color: #555; font-size: 0.9em; }
      pre { background: #f6f6f6; padding: 1rem; overflow-x: auto; white-space: pre-wrap; }
    </style>
  </head>
  <body>
    <h1>InCatalog — Third-party licenses</h1>
    <p>
      InCatalog is licensed under Apache-2.0. It bundles the following
      third-party open-source components, each under the license shown.
    </p>
    <ul>
      {{#each overview}}
      <li><a href="#{{id}}">{{name}}</a> — {{count}} crate(s)</li>
      {{/each}}
    </ul>
    {{#each licenses}}
    <h2 id="{{id}}">{{name}} ({{id}})</h2>
    <p class="crates">Used by:
      {{#each used_by}}{{crate.name}} {{crate.version}}{{#unless @last}}, {{/unless}}{{/each}}
    </p>
    <pre>{{text}}</pre>
    {{/each}}
  </body>
</html>
